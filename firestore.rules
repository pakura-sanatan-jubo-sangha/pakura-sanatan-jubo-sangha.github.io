rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMainAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'freelancerkajolchandradas@gmail.com';
    }

    // Check admin privilege: verified main admin email or document in admins collection
    function isAdmin() {
      return isSignedIn() && (
        isMainAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Helpers ---
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['admin', 'president', 'treasurer', 'secretary', 'member'] &&
             data.status in ['active', 'inactive', 'pending'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120));
    }

    function isValidMember(data) {
      return data.systemId is string && data.systemId.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.status in ['active', 'inactive'] &&
             data.currentBalance is number;
    }

    function isValidContribution(data) {
      return data.contributionId is string && data.contributionId.size() <= 64 &&
             data.memberSystemId is string && data.memberSystemId.size() <= 64 &&
             data.amount is number && data.amount > 0 &&
             data.month is string && data.month.size() <= 20;
    }

    function isValidReceipt(data) {
      return data.receiptId is string && data.receiptId.size() <= 64 &&
             data.amount is number && data.amount > 0 &&
             data.date is string && data.date.size() <= 20 &&
             data.purpose is string && data.purpose.size() <= 255;
    }

    function isValidWithdrawal(data) {
      return data.withdrawalId is string && data.withdrawalId.size() <= 64 &&
             data.memberSystemId is string && data.memberSystemId.size() <= 64 &&
             data.amount is number && data.amount > 0 &&
             data.date is string && data.date.size() <= 20;
    }

    function isValidLog(data) {
      return data.logId is string && data.logId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.action is string && data.action.size() <= 100 &&
             data.module is string && data.module.size() <= 100;
    }

    // 1. Admins Registry
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 2. User Profiles: Allow read and write so members and administrators can log in and register from any domain
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 3. Organization Settings & Security Configuration
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 4. System Metadata & State
    match /_system_meta/{metaId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 5. Connection Test Ping
    match /_connection_test/{testId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 3. Members Registry: Association members
    match /members/{memberId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 4. Monthly Contributions: Financial transactions
    match /contributions/{contributionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 5. Loans
    match /loans/{loanId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 6. Loan Payments
    match /loan_payments/{paymentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 7. Member Withdrawals
    match /member_withdrawals/{withdrawalId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 8. Official Receipts
    match /receipts/{receiptId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 9. Society Rules & Regulations
    match /rules/{ruleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 10. General Meetings & Attendance
    match /meetings/{meetingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 11. Activity & Security Audit Logs
    match /activity_logs/{logId} {
      allow get, list, create, update, delete: if true;
    }

    // 12. Income Records
    match /incomes/{incomeId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 13. Expense Records
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 14. Profit Distributions
    match /profit_distributions/{distributionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // 15. Master Ledger Transactions
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}
